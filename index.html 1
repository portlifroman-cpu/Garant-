<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#102e4d"><title>Garant — Карта продаж</title><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"><style>
:root{font-family:system-ui,-apple-system,sans-serif;color:#142a3e;background:#f3f6fa}*{box-sizing:border-box}body{margin:0}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0;border-radius:10px;padding:11px 15px;font-weight:650}input,select,textarea{width:100%;border:1px solid #cad5df;border-radius:9px;padding:10px;background:white;margin:5px 0 12px}label{font-size:13px;font-weight:600}.primary{background:#0876ed;color:#fff}.light{background:#e8f1ff;color:#135bac}.top{background:#102e4d;color:white;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;gap:10px}.top b{font-size:22px}.top small{font-size:13px}.top button{background:#ffffff24;color:white}.shell{max-width:1440px;margin:auto;padding:12px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:10px}.stat,.side,.mapbox{background:white;border:1px solid #e0e8ef;border-radius:14px;padding:13px}.stat strong{font-size:24px;display:block}.stat span{font-size:12px;color:#66788b}.layout{display:grid;grid-template-columns:270px 1fr;gap:10px}.side h3{margin:0 0 10px}.side button{width:100%}#map{height:calc(100vh - 205px);min-height:480px;border-radius:10px}.legend{display:flex;gap:10px;flex-wrap:wrap;font-size:12px;margin-top:10px}.dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:4px}.modal{position:fixed;inset:0;background:#0a1c2ca8;z-index:3000;display:none;align-items:center;justify-content:center;padding:12px}.modal.open{display:flex}.sheet{width:min(520px,100%);background:white;padding:18px;border-radius:16px;max-height:90vh;overflow:auto}.head{display:flex;justify-content:space-between;align-items:start}.head h2{margin:0 0 12px}.close{background:#eef1f4;padding:7px 11px}.actions{display:flex;gap:8px;margin-top:13px}.actions button{flex:1}.history{background:#f4f7fa;border-radius:9px;padding:10px;margin:8px 0;font-size:13px}.muted{color:#73818d;font-size:12px}.hidden{display:none!important}.notice{padding:12px;background:#fff8e3;border-radius:10px;margin-bottom:10px}#auth{max-width:440px;margin:9vh auto;background:white;border:1px solid #e1e8ef;padding:24px;border-radius:16px}#auth h1{margin-top:0}#auth button{width:100%}#toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#183248;color:#fff;padding:12px 16px;border-radius:10px;display:none;z-index:4000}.fab{position:fixed;bottom:25px;right:25px;background:#0876ed;color:white;font-size:28px;border-radius:50%;height:58px;width:58px;box-shadow:0 4px 15px #0004;z-index:900}.mobile-nav{display:none}@media(max-width:780px){.stats{grid-template-columns:repeat(2,1fr)}.layout{display:block}.side{display:none}.shell{padding:7px}.mapbox{padding:6px}#map{height:calc(100vh - 230px);min-height:430px}.fab{bottom:75px}.mobile-nav{display:flex;position:fixed;bottom:0;left:0;right:0;height:60px;background:white;z-index:950;align-items:center;justify-content:space-around;border-top:1px solid #dce5ec}.mobile-nav button{background:none;color:#2561a5;font-size:12px}.modal{align-items:flex-end;padding:0}.sheet{border-radius:16px 16px 0 0;width:100%}.top b{font-size:19px}}
</style></head><body>
<div id="auth"><h1>Garant <small>Карта продаж</small></h1><p>Вход для сотрудников и руководителя</p><label>Рабочая почта</label><input id="email" type="email" autocomplete="username" placeholder="имя@компания.es"><label>Пароль</label><input id="password" type="password" autocomplete="current-password"><button id="login" class="primary">Войти</button><button id="recover" type="button" class="light" style="margin-top:8px">Восстановить пароль</button><p id="authMsg" class="muted" role="status" aria-live="polite">Введите рабочую почту и пароль, созданные для Garant в Supabase.</p></div>
<div id="app" class="hidden"><div class="top"><div><b>GARANT</b> <small>Карта продаж</small></div><div><span id="who"></span> <button id="signout">Выйти</button></div></div><div class="shell"><div class="stats"><div class="stat"><strong id="countAll">0</strong><span>Всего магазинов</span></div><div class="stat"><strong id="countClient">0</strong><span>Клиенты Garant</span></div><div class="stat"><strong id="countInterest">0</strong><span>Заинтересованы</span></div><div class="stat"><strong id="countVisit">0</strong><span>Визиты сегодня</span></div></div><div class="layout"><aside class="side"><h3>Фильтры</h3><label>Название магазина</label><input id="search" placeholder="Поиск магазина"><label>Город</label><select id="city"><option value="">Все города</option></select><label>Статус</label><select id="status"><option value="">Все статусы</option></select><label id="agentLabel">Агент</label><select id="agent"><option value="">Все агенты</option></select><button class="light" id="reset">Сбросить</button><p class="muted">Все изменения сохраняются в общей базе.</p></aside><main class="mapbox"><div id="map"></div><div class="legend" id="legend"></div></main></div></div><button id="add" class="fab" aria-label="Добавить магазин">+</button><nav class="mobile-nav"><button id="near">📍<br>Рядом</button><button id="list">🏬<br>Магазины</button><button id="newMobile">➕<br>Новый магазин</button></nav></div>
<div class="modal" id="shopModal"><div class="sheet"><div class="head"><div><h2 id="shopName"></h2><div class="muted" id="shopAddress"></div></div><button class="close">×</button></div><p id="shopStatus"></p><div id="shopInfo"></div><h3>История визитов</h3><div id="history"></div><div class="actions"><button class="primary" id="startVisit">Записать визит</button><button class="light" id="route">Маршрут</button></div></div></div>
<div class="modal" id="newModal"><div class="sheet"><div class="head"><h2>Новый магазин</h2><button class="close">×</button></div><label>Название *</label><input id="newName"><label>Тип магазина</label><select id="newType"><option>Minimarket</option><option>Estanco</option><option>Supermercado</option><option>Gasolinera</option><option>Другое</option></select><label>Город</label><input id="newCity" value="Marbella"><label>Адрес</label><input id="newAddress"><label>Телефон</label><input id="newPhone" type="tel"><label>Комментарий</label><textarea id="newComment" rows="2"></textarea><label>Статус</label><select id="newStatus"></select><button class="light" id="geoNew">📍 Моё местоположение (GPS)</button><button class="light" id="pickOnMap" type="button" style="margin:6px 0">🗺️ Выбрать место на карте</button><p id="newPosition" class="muted">Выберите метку нажатием на карту или определите своё местоположение по GPS.</p><button class="primary" id="saveNew">Добавить магазин</button></div></div>
<div class="modal" id="visitModal"><div class="sheet"><div class="head"><h2>Новый визит</h2><button class="close">×</button></div><label>Результат визита</label><select id="visitStatus"></select><label>Комментарий</label><textarea id="visitComment" rows="4"></textarea><label>Следующий визит</label><input id="visitNext" type="date"><p class="muted">При сохранении запросим GPS и запишем время посещения. Если геопозиция недоступна, визит сохранится без координат.</p><button class="primary" id="saveVisit">Сохранить визит</button></div></div>
<div class="modal" id="listModal"><div class="sheet"><div class="head"><h2>Магазины</h2><button class="close">×</button></div><div id="shopList"></div></div></div><div id="toast"></div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script type="module">
let createClient;
try {
  ({createClient}=await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.57.0/+esm'));
} catch(firstError) {
  try {({createClient}=await import('https://esm.sh/@supabase/supabase-js@2.57.0'));}
  catch(secondError) {
    document.getElementById('authMsg').textContent='Не удалось загрузить модуль входа. Проверьте интернет и повторно откройте страницу в Safari. '+secondError.message;
    throw secondError;
  }
}

const URL='https://bxibrptyonhxcdnizacp.supabase.co';const KEY='sb_publishable_0bGaJhD7GxVh_UqaPAUFmA_PhR3ISMP';const db=createClient(URL,KEY);
const colors={'Клиент Garant':'#17a34a','Заинтересован':'#edc200','Оставили образцы':'#1375f2','Повторный визит':'#fa7b21','Отказ':'#db3434','Не посещён':'#98a4b1'};
const $=id=>document.getElementById(id);let session=null,profile=null,map=null,markers=[],shops=[],visits=[],selected=null,newCoords=null,channel=null,pickingPin=false,draftPin=null;
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
window.addEventListener('error',e=>{const el=document.getElementById('authMsg');if(el&&!document.getElementById('auth').classList.contains('hidden'))el.textContent='Ошибка приложения: '+e.message;});
function toast(s){$('toast').textContent=s;$('toast').style.display='block';setTimeout(()=>$('toast').style.display='none',3000)}
function modal(id){$(id).classList.add('open')}function close(){document.querySelectorAll('.modal').forEach(x=>x.classList.remove('open'))}document.querySelectorAll('.close').forEach(x=>x.onclick=close);
async function login(){
 const email=$('email').value.trim(), password=$('password').value;
 if(!email||!password){$('authMsg').textContent='Введите рабочую почту и пароль';return}
 $('login').disabled=true;$('login').textContent='Проверяем вход…';$('authMsg').textContent='Подключаемся к базе Garant…';
 try {
   const {error}=await db.auth.signInWithPassword({email,password});
   if(error){$('authMsg').textContent=error.message==='Invalid login credentials'?'Неверная почта или пароль. Проверьте раскладку или восстановите пароль.':'Ошибка входа: '+error.message;return}
   await boot();
 }catch(e){$('authMsg').textContent='Не удалось подключиться к серверу: '+(e.message||String(e))}
 finally{$('login').disabled=false;$('login').textContent='Войти'}
}
$('recover').onclick=async()=>{let email=$('email').value.trim();if(!email){$('authMsg').textContent='Сначала введите рабочую почту';return} $('recover').disabled=true;try{const {error}=await db.auth.resetPasswordForEmail(email,{redirectTo:location.origin+location.pathname});$('authMsg').textContent=error?'Ошибка восстановления: '+error.message:'Если почта зарегистрирована, проверьте письмо со ссылкой для восстановления пароля.'}catch(e){$('authMsg').textContent='Не удалось запросить письмо: '+e.message}finally{$('recover').disabled=false}};

$('login').onclick=login; $('password').addEventListener('keydown',e=>{if(e.key==='Enter')login()});
async function boot(){const {data:{user},error:userError}=await db.auth.getUser();if(userError){$('authMsg').textContent='Ошибка проверки пользователя: '+userError.message;return}if(!user){$('auth').classList.remove('hidden');$('app').classList.add('hidden');return}
const {data,error}=await db.from('profiles').select('id,full_name,role,active').eq('id',user.id).single();if(error||!data?.active){$('authMsg').textContent='Учётная запись не активирована в Garant. '+(error?.message||'Обратитесь к руководителю.');await db.auth.signOut();return}
profile=data;session=user;$('agentLabel').classList.toggle('hidden',data.role!=='manager');$('agent').classList.toggle('hidden',data.role!=='manager');$('who').textContent=(data.full_name||'Сотрудник')+(data.role==='manager'?' · Руководитель':' · Агент');$('auth').classList.add('hidden');$('app').classList.remove('hidden');if(!map){if(!window.L){$('authMsg').textContent='Карта не загрузилась. Проверьте интернет и обновите страницу.';return}map=L.map('map').setView([36.51,-4.89],12);map.on('click',e=>{if(!pickingPin)return;pickingPin=false;map.getContainer().style.cursor='';setNewCoords({lat:e.latlng.lat,lng:e.latlng.lng});modal('newModal');toast('Место выбрано. Заполните карточку магазина.');});L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'© OpenStreetMap'}).addTo(map)}setTimeout(()=>map.invalidateSize(),100);
await load();if(channel)db.removeChannel(channel);channel=db.channel('garant_map_changes').on('postgres_changes',{event:'*',schema:'public',table:'shops'},()=>load()).on('postgres_changes',{event:'*',schema:'public',table:'visits'},()=>load()).subscribe();}
async function load(){const [a,b]=await Promise.all([db.from('shops').select('*').order('created_at',{ascending:false}),db.from('visits').select('*').order('created_at',{ascending:false}).limit(1000)]);if(a.error||b.error){toast('Ошибка загрузки: '+(a.error||b.error).message);return}shops=a.data||[];visits=b.data||[];draw()}
function pin(status){return L.divIcon({className:'',html:`<div style="height:22px;width:22px;background:${colors[status]};border:3px solid white;border-radius:50% 50% 50% 0;transform:rotate(-45deg);box-shadow:0 2px 6px #0005"></div>`,iconSize:[22,22],iconAnchor:[11,22]})}
function draw(){if(!map)return;markers.forEach(x=>map.removeLayer(x));markers=[];const city=$('city').value,status=$('status').value,agent=$('agent').value,q=$('search').value.toLowerCase();const cs=[...new Set(shops.map(x=>x.city).filter(Boolean))].sort();$('city').innerHTML='<option value="">Все города</option>'+cs.map(x=>`<option ${x===city?'selected':''}>${esc(x)}</option>`).join('');
const agentIds=[...new Set(shops.map(x=>x.agent_id).filter(Boolean))];$('agent').innerHTML='<option value="">Все агенты</option>'+agentIds.map((id,i)=>`<option value="${esc(id)}" ${id===agent?'selected':''}>Агент ${i+1}</option>`).join('');
shops.filter(x=>(!city||x.city===city)&&(!status||x.status===status)&&(!agent||x.agent_id===agent)&&(!q||(x.name+' '+x.address+' '+x.phone).toLowerCase().includes(q))).forEach(x=>{markers.push(L.marker([x.lat,x.lng],{icon:pin(x.status)}).addTo(map).on('click',()=>openShop(x)))});
$('countAll').textContent=shops.length;$('countClient').textContent=shops.filter(x=>x.status==='Клиент Garant').length;$('countInterest').textContent=shops.filter(x=>x.status==='Заинтересован').length;$('countVisit').textContent=visits.filter(x=>(profile.role==='manager'||x.agent_id===session.id)&&new Date(x.created_at).toDateString()===new Date().toDateString()).length;}
function openShop(x){selected=x;$('shopName').textContent=x.name;$('shopAddress').textContent=[x.city,x.address].filter(Boolean).join(', ');$('shopStatus').textContent=x.status;$('shopInfo').innerHTML='<p><b>Телефон:</b> '+esc(x.phone||'—')+'</p><p><b>Комментарий:</b> '+esc(x.comment||'—')+'</p>';
const vv=visits.filter(v=>v.shop_id===x.id);$('history').innerHTML=vv.length?vv.map(v=>`<div class="history"><b>${esc(v.status)}</b><p>${esc(v.comment)}</p><span class="muted">${new Date(v.created_at).toLocaleString('ru-RU')}</span></div>`).join(''):'<p class="muted">Посещений пока нет</p>';modal('shopModal')}
$('startVisit').onclick=()=>{close();$('visitStatus').value=selected.status==='Не посещён'?'Заинтересован':selected.status;$('visitComment').value='';$('visitNext').value='';modal('visitModal')};$('route').onclick=()=>window.open('https://www.google.com/maps/dir/?api=1&destination='+selected.lat+','+selected.lng,'_blank');
function getGeo(){return new Promise(resolve=>{if(!navigator.geolocation)return resolve(null);navigator.geolocation.getCurrentPosition(p=>resolve({lat:p.coords.latitude,lng:p.coords.longitude}),()=>resolve(null),{enableHighAccuracy:true,timeout:9000})})}
$('saveVisit').onclick=async()=>{if(!selected)return;const status=$('visitStatus').value,comment=$('visitComment').value;const pos=await getGeo();const row={shop_id:selected.id,agent_id:session.id,status,comment,next_visit:$('visitNext').value||null,...(pos||{})};const {error}=await db.from('visits').insert(row);if(error)return toast('Не удалось сохранить визит: '+error.message);const {error:err2}=await db.from('shops').update({status,comment,next_visit:row.next_visit}).eq('id',selected.id);if(err2)toast('Визит записан, но статус магазина не обновился: '+err2.message);else toast('Визит сохранён');close();await load()};
function setNewCoords(pos){newCoords=pos;if(draftPin){map.removeLayer(draftPin);draftPin=null}if(pos){draftPin=L.marker([pos.lat,pos.lng],{icon:pin('Не посещён')}).addTo(map);$('newPosition').textContent=`Метка магазина: ${pos.lat.toFixed(6)}, ${pos.lng.toFixed(6)}`;}else{$('newPosition').textContent='Место не выбрано. Выберите точку на карте или разрешите GPS.';}}
$('add').onclick=$('newMobile').onclick=()=>modal('newModal');$('pickOnMap').onclick=()=>{close();pickingPin=true;map.getContainer().style.cursor='crosshair';toast('Нажмите на место магазина на карте');};$('geoNew').onclick=async()=>{const pos=await getGeo();if(!pos)return toast('Не удалось получить координаты — проверьте разрешение GPS');setNewCoords(pos);map.setView([pos.lat,pos.lng],16);};
$('saveNew').onclick=async()=>{const name=$('newName').value.trim();if(!name)return toast('Введите название магазина');if(!newCoords)return toast('Сначала выберите место на карте или определите GPS');const p=newCoords;const row={name,type:$('newType').value,city:$('newCity').value.trim(),address:$('newAddress').value.trim(),phone:$('newPhone').value.trim(),comment:$('newComment').value.trim(),status:$('newStatus').value,lat:p.lat,lng:p.lng,created_by:session.id,agent_id:session.id};const {error}=await db.from('shops').insert(row);if(error)return toast('Ошибка сохранения: '+error.message);close();['newName','newAddress','newPhone','newComment'].forEach(id=>$(id).value='');setNewCoords(null);map.setView([p.lat,p.lng],16);toast('Магазин добавлен');await load()};
$('near').onclick=async()=>{const pos=await getGeo();if(!pos)return toast('Разрешите доступ к геопозиции');map.setView([pos.lat,pos.lng],16)};
$('list').onclick=()=>{$('shopList').innerHTML=shops.map(x=>`<div class="history"><b>${esc(x.name)}</b> — ${esc(x.status)}<div class="muted">${esc(x.city)}</div></div>`).join('')||'<p>Магазинов пока нет.</p>';modal('listModal')};
$('reset').onclick=()=>{$('search').value=$('status').value=$('city').value=$('agent').value='';draw()};['search','city','status','agent'].forEach(id=>$(id).addEventListener(id==='search'?'input':'change',draw));
$('legend').innerHTML=Object.entries(colors).map(([k,v])=>`<span><i class="dot" style="background:${v}"></i>${k}</span>`).join('');$('status').innerHTML='<option value="">Все статусы</option>'+Object.keys(colors).map(x=>`<option>${x}</option>`).join('');$('newStatus').innerHTML=Object.keys(colors).map(x=>`<option>${x}</option>`).join('');$('visitStatus').innerHTML=Object.keys(colors).filter(x=>x!=='Не посещён').map(x=>`<option>${x}</option>`).join('');
$('signout').onclick=async()=>{await db.auth.signOut();location.reload()};
try{await boot()}catch(e){$('authMsg').textContent='Ошибка запуска приложения: '+(e.message||String(e))}

</script></body></html>
